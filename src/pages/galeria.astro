---
/**
 * Gallery page (`src/pages/galeria.astro`, route `/galeria`).
 *
 * Sourced server-side from `src/data/api/gallery.json` (with menu fallback).
 * Supports images, direct videos, and embeds (YouTube, TikTok, Facebook).
 * Plain layout with tokens, precio-free.
 */
import Layout from '../storefront/layout/Layout.astro';
import SiteHeader from '../storefront/layout/site-header.astro';
import Footer from '../storefront/layout/footer.astro';
import GalleryModal from '../storefront/ui/gallery-modal.astro';
import { loadStorefront, getGalleryCategories } from '../storefront/services/index.js';
import type { GalleryCategory, GalleryItem } from '../storefront/types/menu';

const {
  blocks,
  restaurant,
  settings,
  businessHours,
  decorations,
} = await loadStorefront();

const galleryCategories: GalleryCategory[] = await getGalleryCategories(blocks);

/** Converts common video platform URLs (YouTube, TikTok, Facebook) to embed URLs. */
function resolveEmbedUrl(item: GalleryItem): string | null {
  const url = item.url ?? '';
  if (!url) return null;

  // YouTube watch / shorts / share URLs
  const ytMatch = url.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)([a-zA-Z0-9_-]{11})/);
  if (ytMatch) {
    return `https://www.youtube-nocookie.com/embed/${ytMatch[1]}`;
  }

  // TikTok embed URL
  const ttMatch = url.match(/tiktok\.com\/(?:@[^/]+\/video\/|v\/)(\d+)/);
  if (ttMatch) {
    return `https://www.tiktok.com/embed/v2/${ttMatch[1]}`;
  }

  // Facebook video URL
  if (url.includes('facebook.com') && !url.includes('facebook.com/plugins/video.php')) {
    return `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(url)}&show_text=0`;
  }

  // If already an embed URL or other iframe URL
  return url;
}
---

<Layout title="Galería" seo={settings?.seo}>
  <div class="min-h-screen flex flex-col bg-secondary text-primary-text font-body selection:bg-primary selection:text-white">
    <SiteHeader restaurant={restaurant} settings={settings} />

    <main class="flex-1 px-6 py-16 sm:py-20 max-w-7xl mx-auto w-full">
      <!-- Page Header -->
      <header class="text-center max-w-3xl mx-auto mb-16 space-y-4">
        <h1 class="text-5xl sm:text-7xl font-display text-white leading-none tracking-tight">
          Nuestra Galería
        </h1>
        <p class="text-base sm:text-xl text-primary-text/75 font-normal">
          Conocé el arte, la frescura y la experiencia detrás de cada una de nuestras preparaciones.
        </p>
      </header>

      <!-- Categories with Media -->
      <div class="space-y-16">
        {galleryCategories.map((category) => {
          // A category holding video/embed items renders in WIDE columns — the
          // Pinterest move: media cards get ~2× the width of image cards and the
          // 9:16 embed becomes a full-height hero. Image-only categories keep
          // the dense 4-column masonry.
          const hasRichMedia = category.items.some(
            (i) =>
              i.type === 'video' ||
              i.type === 'embed' ||
              Boolean(i.embed_html) ||
              (!i.type &&
                Boolean(
                  i.url?.endsWith('.mp4') ||
                    i.url?.endsWith('.webm') ||
                    /youtube|youtu\.be|tiktok|facebook/.test(i.url ?? ''),
                )),
          );

          return (
          <section class="space-y-8" data-gallery-category={category.name}>
            <div class="border-b border-white/10 pb-4 flex items-baseline justify-between">
              <h2 class="text-3xl sm:text-4xl font-display text-white tracking-tight flex items-center gap-3">
                <span>{category.name}</span>
                <span class="text-xs font-sans font-bold uppercase tracking-wider text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20">
                  {category.items.length} {category.items.length === 1 ? 'ítem' : 'ítems'}
                </span>
              </h2>
            </div>

            <!-- Masonry: CSS multi-columns, column-major flow. Cards keep their
                 natural height and the columns absorb the mix — no uniform row
                 heights. mb handles vertical spacing (row-gap does not apply to
                 multicol); break-inside-avoid keeps each card in one column.
                 Media categories switch to wide columns so video/embed cards
                 dominate; image-only categories keep the dense 4-col grid. -->
            <div class={hasRichMedia ? 'columns-1 sm:columns-2 gap-6' : 'columns-2 md:columns-3 lg:columns-4 gap-6'}>
              {category.items.map((item) => {
                const embedUrl = resolveEmbedUrl(item);
                const isVideo = item.type === 'video' || (!item.type && Boolean(item.url?.endsWith('.mp4') || item.url?.endsWith('.webm')));
                const isEmbed = item.type === 'embed' || Boolean(item.embed_html) || (!item.type && Boolean(item.url?.includes('youtube') || item.url?.includes('youtu.be') || item.url?.includes('tiktok') || item.url?.includes('facebook')));
                const isAspect916 = item.aspect_ratio === '9/16' || Boolean(item.url?.includes('shorts') || item.url?.includes('tiktok'));

                // Size caps for media cards. The wide 2-col section gives
                // media prominence, but unbounded cards blow up on desktop
                // (604px column → 9:16 embed renders 1074px tall) and on
                // mobile (full width → 636px tall). Landscape media caps at
                // 460px wide (~259px tall); portrait 9:16 gets a tighter cap
                // so its true ratio yields bounded height (~444px mobile /
                // ~533px desktop) — still clearly the tallest card, no longer
                // page-dominating.
                const mediaCard = isAspect916
                  ? ' max-w-[250px] md:max-w-[300px] mx-auto'
                  : isVideo || isEmbed
                    ? ' max-w-[460px] mx-auto'
                    : '';

                return (
                  <article
                    class={`group relative mb-6 break-inside-avoid bg-surface/5 border border-white/10 hover:border-primary/50 rounded-3xl p-2 flex flex-col items-center text-center transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_20px_40px_rgba(220,38,38,0.15)] hover:z-10 cursor-pointer${mediaCard}`}
                    data-gallery-item={item.id}
                    data-gallery-data={JSON.stringify(item)}
                  >
                    <!-- Media Container. Images flow at NATURAL height (that is
                         what makes the masonry vary); videos/embeds keep a fixed
                         16:9 or 9:16 frame. -->
                    <div class={`relative w-full rounded-2xl bg-secondary/80 overflow-hidden ${
                      isAspect916 ? 'aspect-[9/16]' : (isVideo || isEmbed ? 'aspect-video' : 'flex items-center justify-center p-4')
                    }`}>
                      {item.embed_html ? (
                        <div class="w-full h-full flex items-center justify-center [&_iframe]:w-full [&_iframe]:h-full [&_iframe]:border-0" set:html={item.embed_html} />
                      ) : isEmbed && embedUrl ? (
                        <iframe
                          src={embedUrl}
                          title={item.title}
                          class="w-full h-full border-0"
                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                          allowfullscreen
                          loading="lazy"
                        />
                      ) : isVideo && item.url ? (
                        <video
                          src={item.url}
                          poster={item.poster}
                          controls
                          playsinline
                          preload="metadata"
                          class="w-full h-full object-cover"
                        />
                      ) : item.url ? (
                        <img
                          src={item.url}
                          alt={item.alt || item.title}
                          loading="lazy"
                          class="w-full h-auto transform group-hover:scale-110 group-hover:-rotate-2 transition-transform duration-500 ease-out drop-shadow-xl"
                        />
                      ) : null}
                    </div>

                  </article>
                );
              })}
            </div>
          </section>
          );
        })}
      </div>
    </main>

    <Footer
      restaurant={restaurant}
      settings={settings}
      businessHours={businessHours}
      footerBg={decorations?.footer_bg}
      class="mt-20 block"
    />

    <!-- Expanded Media Modal (Lightbox) -->
    <GalleryModal />
  </div>
</Layout>
