---
/**
 * Block: divider
 * A labeled section separator.
 */
const { block } = Astro.props;
const { label, id } = block;
---

<div data-block-divider={id} class="flex items-center gap-3 py-1">
  <div class="flex-1 h-px bg-white/10" />
  {label && (
    <span class="text-xs font-semibold text-primary-text/40 uppercase tracking-widest whitespace-nowrap px-1">
      {label}
    </span>
  )}
  <div class="flex-1 h-px bg-white/10" />
</div>
