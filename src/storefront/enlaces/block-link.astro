---
/**
 * Block: link
 * Renders a styled CTA / social button.
 *
 * Props from the enlaces service:
 *   block.style      — "primary" | "social" | "default"
 *   block.color      — optional accent hint: "instagram"|"facebook"|"tiktok"|"amber"|"neutral"
 *   block.label      — main text
 *   block.resolved_sublabel — secondary text (already resolved)
 *   block.icon       — icon key
 *   block.resolved_href     — fully resolved URL
 *   block.target     — link target
 */
import WhatsApp from '../icons/whatsapp.astro';
import Utensils from '../icons/utensils.astro';
import Instagram from '../icons/instagram.astro';
import TikTok from '../icons/tiktok.astro';
import MapPin from '../icons/map-pin.astro';
import Phone from '../icons/phone.astro';
import ArrowUpRight from '../icons/arrow-up-right.astro';

const { block } = Astro.props;
const { style, color, label, resolved_sublabel, icon, resolved_href, target, id } = block;

const colorMap = {
  instagram: { bg: 'bg-pink-500/10', border: 'border-pink-500/20', text: 'text-pink-400', hover: 'group-hover:bg-pink-500 group-hover:text-white' },
  facebook:  { bg: 'bg-blue-500/10',  border: 'border-blue-500/20',  text: 'text-blue-400',  hover: 'group-hover:bg-blue-500 group-hover:text-white'  },
  tiktok:    { bg: 'bg-cyan-500/10',   border: 'border-cyan-500/20',   text: 'text-cyan-400',   hover: 'group-hover:bg-cyan-500 group-hover:text-white'   },
  amber:     { bg: 'bg-amber-500/10',  border: 'border-amber-500/20',  text: 'text-amber-400',  hover: 'group-hover:bg-amber-500 group-hover:text-white'  },
  neutral:   { bg: 'bg-white/10',      border: 'border-white/20',      text: 'text-white',       hover: 'group-hover:bg-primary group-hover:border-primary' },
  default:   { bg: 'bg-primary/10',    border: 'border-primary/20',    text: 'text-primary',     hover: 'group-hover:bg-primary group-hover:text-white'    },
};
const c = colorMap[color] ?? colorMap.default;
---

{resolved_href && (
  <a
    href={resolved_href}
    target={target ?? '_self'}
    rel={target === '_blank' ? 'noopener noreferrer' : undefined}
    data-block-link={id}
    class:list={[
      'group relative flex items-center justify-between p-4 rounded-2xl shadow-md',
      'hover:scale-[1.02] active:scale-[0.98] transition-all duration-200',
      style === 'primary'
        ? 'bg-emerald-600/90 hover:bg-emerald-600 text-white border border-emerald-500/30 shadow-[0_10px_25px_rgba(16,185,129,0.25)]'
        : 'bg-surface/5 hover:bg-surface/10 text-white border border-white/10 hover:border-primary/40',
    ]}
  >
    <div class="flex items-center gap-3.5">
      <div class:list={[
        'w-10 h-10 rounded-xl flex items-center justify-center transition-colors',
        style === 'primary' ? 'bg-white/20 text-white' : `${c.bg} ${c.border} border ${c.text} ${c.hover}`,
      ]}>
        {icon === 'whatsapp' && <WhatsApp class="w-5 h-5" />}
        {icon === 'utensils' && <Utensils class="w-5 h-5" />}
        {icon === 'instagram' && <Instagram class="w-5 h-5" />}
        {icon === 'facebook' && (
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
          </svg>
        )}
        {icon === 'tiktok' && <TikTok class="w-5 h-5" />}
        {icon === 'map-pin' && <MapPin class="w-5 h-5" />}
        {icon === 'phone' && <Phone class="w-5 h-5" />}
      </div>
      <div class="text-left">
        <div class="text-sm font-bold leading-tight">{label}</div>
        {resolved_sublabel && (
          <div class="text-xs text-primary-text/60 line-clamp-1">{resolved_sublabel}</div>
        )}
      </div>
    </div>
    <ArrowUpRight class="w-5 h-5 text-primary-text/40 group-hover:text-primary group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform flex-shrink-0" />
  </a>
)}
