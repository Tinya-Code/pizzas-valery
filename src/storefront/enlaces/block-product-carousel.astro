---
/**
 * Block: product-carousel
 * Horizontal scrollable strip of product cards sourced from the menu.
 * Each card shows the product image, name, and min price.
 */
const { block } = Astro.props;
const { title, subtitle, resolved_cta_href, cta_label, _products: products = [], id } = block;

function formatPrice(p) {
  if (!p && p !== 0) return '';
  return `S/ ${Number(p).toFixed(0)}`;
}
---

<div data-block-product-carousel={id} class="space-y-3">
  {(title || subtitle) && (
    <div class="flex items-end justify-between px-0.5">
      <div>
        {title && <h2 class="text-base font-bold text-white leading-tight">{title}</h2>}
        {subtitle && <p class="text-xs text-primary-text/50 mt-0.5">{subtitle}</p>}
      </div>
      {resolved_cta_href && cta_label && (
        <a
          href={resolved_cta_href}
          class="text-xs text-primary font-semibold hover:underline underline-offset-2 flex-shrink-0 ml-3"
        >
          {cta_label} →
        </a>
      )}
    </div>
  )}

  {products.length > 0 ? (
    <div
      class="flex gap-3 overflow-x-auto pb-2 snap-x snap-mandatory scroll-smooth"
      style="scrollbar-width: none; -ms-overflow-style: none;"
    >
      {products.map((product) => (
        <a
          href="/menu"
          class="group flex-shrink-0 w-36 snap-start rounded-2xl border border-white/8 bg-surface/5 overflow-hidden hover:border-primary/40 hover:scale-[1.03] transition-all duration-200"
        >
          <div class="w-full h-28 bg-white/5 overflow-hidden">
            {product.image?.url ? (
              <img
                src={product.image.url}
                alt={product.image.alt ?? product.name}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-primary-text/20">
                <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                  <path d="M3 2v7c0 1.1.9 2 2 2h4a2 2 0 0 0 2-2V2"/><path d="M7 2v20"/><path d="M21 15V2v0a5 5 0 0 0-5 5v6c0 1.1.9 2 2 2h3Zm0 0v7"/>
                </svg>
              </div>
            )}
          </div>
          <div class="p-2.5 space-y-0.5">
            <p class="text-xs font-semibold text-white line-clamp-2 leading-tight">{product.name}</p>
            {(product.price_range?.min_price ?? product.price) > 0 && (
              <p class="text-xs text-primary font-bold">
                desde {formatPrice(product.price_range?.min_price ?? product.price)}
              </p>
            )}
          </div>
        </a>
      ))}
    </div>
  ) : (
    <p class="text-xs text-primary-text/40 italic px-0.5">No hay productos para mostrar.</p>
  )}
</div>
