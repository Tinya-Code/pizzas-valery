---
/**
 * Home Hero section.
 *
 * Props:
 *   restaurantName  — brand name
 *   tagline         — SEO description / subtitle
 *   isOpen          — boolean|null  (null = unknown)
 *   openLabel       — "11:00 – 22:30" | null
 *   whatsappUrl     — string | null
 *
 * Block-driven config (`landing.json` → `hero` block):
 *   background_video — { enabled, src, type, poster, autoplay, loop, muted, preload }
 *   scroll_reveal    — { overlay_from, overlay_to, content_fade_px, overlay_range_vh }
 */
import ArrowRight from "../icons/arrow-right.astro";
import WhatsApp from "../icons/whatsapp.astro";

const {
  block,
  restaurantName: fallbackName,
  tagline: fallbackTagline,
  isOpen = null,
  openLabel = null,
  whatsappUrl: fallbackWaUrl = null,
} = Astro.props;

const restaurantName = block?.title || fallbackName;
const tagline = block?.tagline || fallbackTagline;
const whatsappUrl = block?._resolved_whatsapp_href ?? fallbackWaUrl;
const whatsappLabel = block?.cta_whatsapp?.label ?? "Pedir por WhatsApp";
const showWhatsapp = block?.cta_whatsapp
  ? block.cta_whatsapp.enabled !== false && !!whatsappUrl
  : !!whatsappUrl;
const menuHref = block?._resolved_menu_href ?? "/menu";
const menuLabel = block?.cta_menu?.label ?? "Ver menú completo";
const showMenu = block?.cta_menu ? block.cta_menu.enabled !== false : true;
const showBadge = block?.show_hours_badge ?? true;

// Background video — configurable from landing.json; without it (or when
// disabled) the hero keeps the flat `bg-secondary` fallback.
const videoCfg = block?.background_video ?? null;
const showVideo = !!videoCfg?.src && videoCfg.enabled !== false;
const videoSrc = videoCfg?.src;
const videoType = videoCfg?.type ?? "video/webm";
const videoPoster = videoCfg?.poster ?? undefined;
const videoAutoplay = videoCfg?.autoplay !== false;
const videoLoop = videoCfg?.loop !== false;
const videoMuted = videoCfg?.muted !== false;
const videoPreload = videoCfg?.preload ?? "auto";

// Scroll-linked reveal tuning — exposed as data-* so the client script reads
// the same values the server rendered (no duplicated constants).
const revealCfg = block?.scroll_reveal ?? {};
const overlayFrom = revealCfg.overlay_from ?? 0.15;
const overlayTo = revealCfg.overlay_to ?? 0.7;
const contentFadePx = revealCfg.content_fade_px ?? 90;
const overlayRangeVh = revealCfg.overlay_range_vh ?? 45;
---

<section
  data-hero
  data-overlay-from={overlayFrom}
  data-overlay-to={overlayTo}
  data-fade-px={contentFadePx}
  data-overlay-vh={overlayRangeVh}
  class="relative min-h-screen flex flex-col items-center justify-center text-center px-6 pt-20 pb-16 sm:pt-28 sm:pb-24 overflow-hidden"
>
  <!-- Video background: black fallback (bg-secondary) if it never plays. -->
  <div class="absolute inset-0 z-0 overflow-hidden bg-secondary" aria-hidden="true">
    {
      showVideo && (
        <video
          class="w-full h-full object-cover"
          autoplay={videoAutoplay}
          muted={videoMuted}
          loop={videoLoop}
          playsinline
          preload={videoPreload}
          poster={videoPoster}
        >
          <source src={videoSrc} type={videoType} />
        </video>
      )
    }
    <!-- Dark layer: starts faint, deepens as the user scrolls. -->
    <div data-hero-overlay class="absolute inset-0 bg-black" style={`opacity: ${overlayFrom}`}></div>
  </div>

  <noscript>
    <style>
      [data-hero-extra] {
        opacity: 1 !important;
        transform: none !important;
        pointer-events: auto !important;
      }
    </style>
  </noscript>

  <div class="relative z-10 max-w-3xl mx-auto space-y-6">
    <!-- Brand headline -->
    <h1
      class="text-6xl md:text-8xl font-display text-white leading-none tracking-tighter"
    >
      {restaurantName}
    </h1>

    <div
      data-hero-extra
      class="space-y-6"
      style="opacity: 0; transform: translateY(16px); pointer-events: none;"
    >
      <p
        class="text-lg md:text-xl text-primary-text/75 font-normal max-w-lg mx-auto leading-relaxed"
      >
        {tagline}
      </p>

    {
      showBadge && isOpen !== null && (
        <div
          id="hero-hours-badge"
          data-state={isOpen ? "open" : "closed"}
          class="inline-flex items-center px-4 py-2 rounded-full border border-white/10 bg-white/5 text-xs font-bold tracking-wider uppercase"
        >
          {/* Both states are pre-rendered; the client script flips [hidden]
              so no Tailwind display utility ever fights the hidden attribute. */}
          <span data-part="open" hidden={isOpen !== true}>
            <span class="inline-flex items-center gap-2.5 text-emerald-300">
              <span class="relative flex h-2 w-2">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60" />
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-400" />
              </span>
              Abierto
              {openLabel && (
                <span
                  data-hours="open"
                  class="text-primary-text/60 font-medium normal-case tracking-normal"
                >
                  {openLabel}
                </span>
              )}
            </span>
          </span>
          <span data-part="closed" hidden={isOpen !== false}>
            <span class="inline-flex items-center gap-2.5 text-red-300">
              <span class="relative inline-flex rounded-full h-2 w-2 bg-red-400" />
              Cerrado
              {openLabel && (
                <span
                  data-hours="closed"
                  class="text-primary-text/60 font-medium normal-case tracking-normal"
                >
                  {openLabel}
                </span>
              )}
            </span>
          </span>
        </div>
      )
    }

    <!-- Dual CTA -->
    <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
      {
        showWhatsapp && whatsappUrl && (
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            id="hero-whatsapp-cta"
            class="group inline-flex items-center justify-center gap-2.5 px-7 py-3.5 bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-bold rounded-2xl shadow-[0_8px_24px_rgba(16,185,129,0.3)] hover:shadow-[0_12px_30px_rgba(16,185,129,0.4)] hover:scale-[1.03] active:scale-[0.97] transition-all duration-200"
          >
            <WhatsApp class="w-5 h-5" />
            {whatsappLabel}
          </a>
        )
      }
      {
        showMenu && (
          <a
            href={menuHref}
            id="hero-menu-cta"
            class="group inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white/5 hover:bg-white/10 border border-white/15 hover:border-primary/50 text-white text-sm font-bold rounded-2xl hover:scale-[1.03] active:scale-[0.97] transition-all duration-200"
          >
            {menuLabel}
            <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </a>
        )
      }
    </div>
    </div><!-- /data-hero-extra -->
  </div>
</section>

<script>
  import { readBusinessHours } from "../utils/dom";
  import { isOpenAt, weekDayKey } from "../services/business-hours.service.js";

  // Static build: the badge ships with the build-time state. Recompute it
  // against the visitor's clock on load and every minute (closing time
  // passes while the tab stays open). The timer stops while the tab is
  // hidden — browsers throttle background intervals anyway — and refreshes
  // immediately on return, since the clock may have crossed an opening or
  // closing boundary in the meantime.
  const badge = document.getElementById("hero-hours-badge");
  const hours = readBusinessHours();

  if (badge && hours) {
    const openPart = badge.querySelector('[data-part="open"]');
    const closedPart = badge.querySelector('[data-part="closed"]');
    const openHours = badge.querySelector('[data-hours="open"]');
    const closedHours = badge.querySelector('[data-hours="closed"]');

    const refresh = () => {
      const now = new Date();
      const open = isOpenAt(hours, now);
      const today = hours[weekDayKey(now)];
      const label =
        today?.isOpen && today.open && today.close
          ? `${today.open} – ${today.close}`
          : "";

      if (openPart instanceof HTMLElement) openPart.hidden = !open;
      if (closedPart instanceof HTMLElement) closedPart.hidden = open;
      if (openHours) openHours.textContent = label;
      if (closedHours) closedHours.textContent = label;
      badge.dataset.state = open ? "open" : "closed";
    };

    let timer: number | undefined;
    const start = () => {
      if (timer === undefined) timer = window.setInterval(refresh, 60_000);
    };
    const stop = () => {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    };

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else {
        refresh();
        start();
      }
    });

    refresh();
    start();
  }
</script>

<script>
  /**
   * Hero scroll reveal — video background + progressive darkening.
   *
   * Initial state (top of the page): video playing, only the <h1> readable.
   * As the user scrolls through the first ~45vh, `data-hero-overlay` deepens
   * and `data-hero-extra` (tagline, hours badge, CTAs) fades/slides in.
   * Everything is scroll-LINKED (proportional to scroll position), so
   * scrolling back to the top restores the initial state.
   *
   * Tuning comes from `landing.json` (`hero.scroll_reveal`) and is rendered
   * onto the section as data-* attributes. With `prefers-reduced-motion`,
   * the static final state is rendered instead (content visible, deep veil,
   * no scroll listeners).
   */
  const initHeroReveal = () => {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    const overlay = hero?.querySelector<HTMLElement>("[data-hero-overlay]");
    const extra = hero?.querySelector<HTMLElement>("[data-hero-extra]");
    const video = hero?.querySelector<HTMLVideoElement>("video");
    if (!hero || !overlay || !extra || hero.dataset.heroReady) return;
    hero.dataset.heroReady = "true";

    const reducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    /** Numeric data-* override with fallback (0 is a valid value). */
    const cfg = (key: string, fallback: number) => {
      const raw = Number(hero.dataset[key]);
      return Number.isFinite(raw) ? raw : fallback;
    };
    const OVERLAY_FROM = cfg("overlayFrom", 0.15); // faint veil so the h1 stays readable at rest
    const OVERLAY_TO = cfg("overlayTo", 0.7); // deep veil once scrolled
    const RISE_PX = 16; // initial extra content offset
    // Content must be readable after the FIRST scroll notch (~one wheel step),
    // while the dark veil keeps deepening progressively across ~45vh.
    const CONTENT_RANGE_PX = cfg("fadePx", 90);
    const overlayRangeVh = cfg("overlayVh", 45);

    // --- Background video: play while the hero is on screen -------------
    if (video) {
      const tryPlay = () => void video.play().catch(() => {});
      if (reducedMotion) {
        video.pause();
      } else {
        tryPlay();
        if ("IntersectionObserver" in window) {
          new IntersectionObserver(
            (entries) => {
              for (const entry of entries) {
                if (entry.isIntersecting) tryPlay();
                else video.pause();
              }
            },
            { threshold: 0.4 },
          ).observe(hero);
        }
      }
    }

    // --- Reduced motion: show the readable end state, don't animate -----
    if (reducedMotion) {
      overlay.style.opacity = `${OVERLAY_TO}`;
      extra.style.opacity = "1";
      extra.style.transform = "none";
      // The server renders `pointer-events: none` for the hidden state;
      // release it or the CTAs stay unclickable without the scroll script.
      extra.style.pointerEvents = "";
      return;
    }

    // --- Scroll-linked reveal -------------------------------------------
    const clamp01 = (value: number) => Math.min(1, Math.max(0, value));
    const overlayRange = () => (window.innerHeight * overlayRangeVh) / 100;

    // heroTop is cached instead of read per frame (one less forced reflow
    // per scroll frame); it is re-measured on resize and on full load, when
    // late layout (web fonts, media) has settled.
    let heroTop = 0;
    const measure = () => {
      heroTop = hero.getBoundingClientRect().top + window.scrollY;
    };

    let ticking = false;
    let lastContent = -1;
    let lastVeil = -1;
    const render = () => {
      ticking = false;
      const scrolled = window.scrollY - heroTop;
      const content = clamp01(scrolled / CONTENT_RANGE_PX);
      const veil = clamp01(scrolled / overlayRange());
      // Nothing moved: skip all style writes (no style recalculation).
      if (content === lastContent && veil === lastVeil) return;
      lastContent = content;
      lastVeil = veil;

      overlay.style.opacity = `${OVERLAY_FROM + (OVERLAY_TO - OVERLAY_FROM) * veil}`;
      extra.style.opacity = `${content}`;
      extra.style.transform =
        content >= 1 ? "none" : `translateY(${(1 - content) * RISE_PX}px)`;

      // Nearly hidden content must not be clickable nor focusable.
      const hidden = content < 0.05;
      extra.toggleAttribute("inert", hidden);
      extra.style.pointerEvents = hidden ? "none" : "";
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(render);
    };
    const onResize = () => {
      measure();
      onScroll();
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onResize);
    // Fonts/media above or inside the hero can shift its offset after load.
    window.addEventListener("load", onResize, { once: true });

    measure();
    render();
  };

  initHeroReveal();
</script>
