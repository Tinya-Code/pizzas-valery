---
/**
 * Home — Media section (banners, flyers, videos).
 *
 * Renders a list of heterogeneous media items declared in
 * `src/data/api/landing.json` under the `media` key.
 *
 * Supported item types:
 *   banner — image + optional overlay text + optional CTA link
 *   flyer  — full-width image (no text overlay; optional link on click)
 *   video  — YouTube / TikTok / Facebook embed, or a video hosted in the repo
 *
 * Layout modes (set per item via `layout`):
 *   "full"  — spans the full container width (default)
 *   "half"  — 2 columns on md+; stacks on mobile
 *   "third" — 3 columns on lg+, 2 on md, stacks on mobile
 *   Consecutive items with the same "half"/"third" layout are grouped into a
 *   row. A leftover item that can't fill a row renders alone at full width.
 *
 * Common item fields:
 *   id, type, layout, enabled (false hides the item)
 *
 * banner: image_url | image, alt, title, description, cta_label,
 *         cta_href | resolved_cta_href, cta_target, min_height
 *
 * flyer:  image_url | image, alt, href | resolved_href, target, aspect
 *
 * video:  provider: 'youtube' | 'tiktok' | 'facebook' | 'local'
 *                   (aliases for local: 'self' | 'repo' | 'mp4' | 'file')
 *         video_id : id OR full URL (youtube / tiktok / facebook)
 *         src      : (local) "/videos/a.mp4"  -> public/videos/a.mp4
 *                           "videos/a.mp4"   -> src/assets/videos/a.mp4
 *                           "https://..."    -> remote file
 *         src_webm : (local, optional) extra WebM source
 *         poster   : (local, optional) poster image
 *         aspect   : '16:9' | '9:16' | '1:1' | '4:5'
 *                    (default: 9:16 for tiktok, 16:9 otherwise)
 *         autoplay, muted, loop, controls : booleans
 *                    (autoplay forces muted; local autoplay videos only play
 *                     while visible on screen)
 *         title, caption
 *
 * Props:
 *   block — section config ({ title, badge, id, _items | items })
 *   items — fallback array of media items
 */
import ArrowUpRight from '../icons/arrow-up-right.astro';
import {
  normalizeProvider,
  resolveAspect,
  buildConfiguredEmbedUrl,
  resolveFromAssets,
  PROVIDER_LABELS,
  ASPECTS,
} from '../utils/video';

const {
  block,
  items: fallbackItems = [],
} = Astro.props;

const rawItems = block?._items ?? block?.items ?? fallbackItems ?? [];
const title = block?.title ?? 'Destacados';
const badge = block?.badge ?? 'Novedades';

// ───────────────────────── Local files (src/assets) ─────────────────────────
const assetFiles = import.meta.glob('/src/assets/**/*.{mp4,webm,mov,m4v,jpg,jpeg,png,webp,avif}', {
  eager: true,
  query: '?url',
  import: 'default',
});

/** Path resolution against this section's asset map (images + video). */
const resolveFile = (path) => resolveFromAssets(path, assetFiles);

/** Image helper: accepts item.image_url / item.image (URL, public path or src/assets path). */
const imageOf = (item) => {
  const raw = item.image_url ?? item.image;
  return raw ? (resolveFile(raw) ?? raw) : null;
};

// ───────────────────────────── Link helpers ─────────────────────────────
const relFor = (target) => (target === '_blank' ? 'noopener noreferrer' : undefined);

// ───────────────────────────── Video helpers ─────────────────────────────
/** Normalises a video item into everything the template needs (or null if unusable). */
function buildVideo(item) {
  const provider = normalizeProvider(item.provider);
  const autoplay = Boolean(item.autoplay);
  const muted = autoplay ? true : Boolean(item.muted);
  const loop = Boolean(item.loop);
  const controls = item.controls !== false;

  const { cssAspect, vertical } = resolveAspect(provider, item.aspect);
  const base = {
    provider,
    autoplay,
    muted,
    loop,
    controls,
    cssAspect,
    vertical,
    label: PROVIDER_LABELS[provider] ?? 'Video',
  };

  if (provider === 'local') {
    const src = resolveFile(item.src ?? item.video_url ?? item.video_id);
    if (!src) return null;
    const poster = item.poster ? (resolveFile(item.poster) ?? item.poster) : undefined;
    return { ...base, kind: 'local', src, webm: resolveFile(item.src_webm), poster };
  }

  const src = buildConfiguredEmbedUrl(provider, item.video_id, {
    autoplay,
    muted,
    loop,
    controls,
  });

  return src ? { ...base, kind: 'embed', src } : null;
}

// ───────────────────────────── Normalise items ─────────────────────────────
const items = rawItems
  .filter((it) => it && it.enabled !== false && it.active !== false)
  .map((it) => (it.type === 'video' ? { ...it, _video: buildVideo(it) } : it))
  .filter((it) => {
    if (it.type === 'video') return Boolean(it._video);
    if (it.type === 'banner' || it.type === 'flyer') return Boolean(imageOf(it));
    return false;
  });

if (items.length === 0) return;

// ───────────────────────────── Grouping into rows ─────────────────────────────
const COLS = { half: 2, third: 3 };
const rows = [];
let i = 0;
while (i < items.length) {
  const cur = items[i];
  const cols = COLS[cur.layout];
  if (cols) {
    const group = [cur];
    while (group.length < cols && items[i + group.length]?.layout === cur.layout) {
      group.push(items[i + group.length]);
    }
    rows.push(group.length > 1 ? { cols: group.length, items: group } : { cols: 1, items: group });
    i += group.length;
  } else {
    rows.push({ cols: 1, items: [cur] });
    i++;
  }
}

const gridClass = (cols) =>
  cols === 3
    ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5'
    : cols === 2
      ? 'grid grid-cols-1 md:grid-cols-2 gap-5'
      : '';

const hasLocalAutoplay = items.some((it) => it._video?.kind === 'local' && it._video.autoplay);
---

{items.length > 0 && (
  <section class="px-6 pb-16 sm:pb-24" id={block?.id ?? 'home-media'}>
    <div class="max-w-5xl mx-auto space-y-8">
      <!-- Section header -->
      <div>
        {badge && <p class="text-xs font-semibold text-primary uppercase tracking-widest mb-1">{badge}</p>}
        <h2 class="text-3xl sm:text-4xl font-display text-white leading-tight">
          {title}<span class="text-primary">.</span>
        </h2>
      </div>

      <!-- Media rows -->
      <div class="space-y-5">
        {rows.map((row) => {
          const compact = row.cols > 1;
          return (
            <div class={gridClass(row.cols)}>
              {row.items.map((item) => {
                const img = imageOf(item);
                const href = item.resolved_href ?? item.href;
                const ctaHref = item.resolved_cta_href ?? item.cta_href;
                const v = item._video;

                return (
                  <div data-media-item={item.id}>
                    {item.type === 'banner' && (
                      <div
                        class:list={[
                          'group relative rounded-2xl overflow-hidden border border-white/10 bg-surface/5 hover:border-primary/30 transition-all duration-300',
                          compact ? 'hover:scale-[1.01]' : 'hover:scale-[1.005]',
                        ]}
                        style={`min-height:${item.min_height ?? (compact ? '180px' : '220px')}`}
                      >
                        <img
                          src={img}
                          alt={item.alt ?? item.title ?? ''}
                          class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                          decoding="async"
                        />
                        {(item.overlay || item.title || item.description || item.cta_label) && (
                          <div
                            class:list={[
                              'absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end space-y-2',
                              compact ? 'p-5' : 'p-6',
                            ]}
                          >
                            {item.title && (
                              <p class:list={['font-bold text-white leading-tight', compact ? 'text-lg' : 'text-2xl']}>
                                {item.title}
                              </p>
                            )}
                            {item.description && (
                              <p
                                class:list={[
                                  'text-sm text-white/75 leading-relaxed',
                                  compact ? 'line-clamp-2' : 'max-w-md',
                                ]}
                              >
                                {item.description}
                              </p>
                            )}
                            {item.cta_label && ctaHref && (
                              <a
                                href={ctaHref}
                                target={item.cta_target ?? '_self'}
                                rel={relFor(item.cta_target)}
                                class:list={[
                                  'inline-flex items-center gap-1.5 self-start bg-primary hover:bg-primary/90 text-white font-bold rounded-xl transition-colors',
                                  compact ? 'px-4 py-2 text-xs' : 'px-5 py-2.5 text-sm mt-1',
                                ]}
                              >
                                {item.cta_label}
                                <ArrowUpRight class:list={['stroke-[2.5]', compact ? 'w-3.5 h-3.5' : 'w-4 h-4']} />
                              </a>
                            )}
                          </div>
                        )}
                      </div>
                    )}
        
                    {item.type === 'flyer' && (() => {
                      const flyerStyle = ASPECTS[item.aspect] ? `aspect-ratio:${ASPECTS[item.aspect]};` : undefined;
                      const imgClass = flyerStyle ? 'w-full h-full object-cover' : 'w-full object-cover';
                      return href ? (
                        <a
                          href={href}
                          target={item.target ?? '_self'}
                          rel={relFor(item.target)}
                          class="group block rounded-2xl overflow-hidden border border-white/10 hover:border-primary/40 transition-all duration-300"
                          style={flyerStyle}
                        >
                          <img
                            src={img}
                            alt={item.alt ?? ''}
                            class={`${imgClass} group-hover:scale-[1.03] transition-transform duration-500`}
                            loading="lazy"
                            decoding="async"
                          />
                        </a>
                      ) : (
                        <div class="rounded-2xl overflow-hidden border border-white/10" style={flyerStyle}>
                          <img src={img} alt={item.alt ?? ''} class={imgClass} loading="lazy" decoding="async" />
                        </div>
                      );
                    })()}

                    {item.type === 'video' && v && (
                      <div class="space-y-2">
                        {item.title && (
                          <h3 class="text-base font-bold text-white px-0.5">{item.title}</h3>
                        )}
                        <div
                          class="relative w-full mx-auto rounded-2xl overflow-hidden border border-white/10 bg-black/30 max-h-100"
                          style={`aspect-ratio:${v.cssAspect};${v.vertical ? 'max-width:360px;' : ''}`}
                        >
                          {v.kind === 'local' ? (
                            <video
                              class="absolute inset-0 w-full h-full object-contain bg-black"
                              controls={v.controls}
                              muted={v.muted}
                              loop={v.loop}
                              playsinline
                              preload={v.autoplay ? 'auto' : 'metadata'}
                              poster={v.poster}
                              data-autoplay={v.autoplay ? 'true' : undefined}
                              aria-label={item.title ?? 'Video'}
                            >
                              {v.webm && <source src={v.webm} type="video/webm" />}
                              <source src={v.src} type="video/mp4" />
                              Tu navegador no soporta la reproducción de video.
                            </video>
                          ) : (
                            <iframe
                              src={v.src}
                              title={item.title ?? `${v.label} video`}
                              class="absolute inset-0 w-full h-full"
                              allow="accelerometer; autoplay; clipboard-write; encrypted-media; fullscreen; gyroscope; picture-in-picture; web-share"
                              allowfullscreen
                              loading="lazy"
                              referrerpolicy="strict-origin-when-cross-origin"
                              frameborder="0"
                            />
                          )}
                        </div>
                        {item.caption && (
                          <p class:list={['text-xs text-primary-text/50 px-0.5 leading-relaxed', v.vertical && 'text-center']}>
                            {item.caption}
                          </p>
                        )}
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}

{hasLocalAutoplay && (
  <script>
    // Local autoplay videos: play only while visible, pause when scrolled away.
    const videos = document.querySelectorAll('video[data-autoplay="true"]');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            const video = entry.target;
            if (entry.isIntersecting) {
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          });
        },
        { threshold: 0.4 }
      );
      videos.forEach((v) => io.observe(v));
    } else {
      videos.forEach((v) => v.play().catch(() => {}));
    }
  </script>
)}