---
/**
 * Home — Media section (banners, flyers, videos).
 *
 * Renders a list of heterogeneous media items declared in
 * `src/data/api/landing.json` under the `media` key.
 *
 * Supported item types:
 *   banner  — image + optional overlay text + optional CTA link
 *   flyer   — full-width image (no text overlay; links somewhere on click)
 *   video   — iframe embed (YouTube / TikTok / Facebook)
 *
 * Layout modes (set per item via `layout`):
 *   "full"   — spans full container width
 *   "half"   — 2-column grid on md+; stacks on mobile
 *
 * Props:
 *   items — array of media items (already loaded by the page)
 */
import ArrowUpRight from '../icons/arrow-up-right.astro';

const {
  block,
  items: fallbackItems = [],
} = Astro.props;

const items = block?._items ?? block?.items ?? fallbackItems;
const title = block?.title ?? 'Destacados';
const badge = block?.badge ?? 'Novedades';

if (items.length === 0) return;

/** Build an embed src from provider + videoId */
function embedSrc(provider, videoId) {
  switch (provider) {
    case 'youtube':
      return `https://www.youtube.com/embed/${videoId}?rel=0&modestbranding=1`;
    case 'tiktok':
      return `https://www.tiktok.com/embed/v2/${videoId}`;
    case 'facebook':
      return `https://www.facebook.com/plugins/video.php?href=${encodeURIComponent(videoId)}&show_text=0`;
    default:
      return null;
  }
}

// Group consecutive "half" items in pairs for the 2-col grid.
// Full items and unpaired halves render alone at full width.
const rows = [];
let i = 0;
while (i < items.length) {
  const cur = items[i];
  if (cur.layout === 'half' && items[i + 1]?.layout === 'half') {
    rows.push({ type: 'pair', items: [cur, items[i + 1]] });
    i += 2;
  } else {
    rows.push({ type: 'single', item: cur });
    i++;
  }
}
---

{items.length > 0 && (
  <section class="px-6 pb-16 sm:pb-24" id={block?.id ?? "home-media"}>
    <div class="max-w-5xl mx-auto space-y-8">
      <!-- Section header -->
      <div>
        {badge && <p class="text-xs font-semibold text-primary uppercase tracking-widest mb-1">{badge}</p>}
        <h2 class="text-3xl sm:text-4xl font-display text-white leading-tight">
          {title}<span class="text-primary">.</span>
        </h2>
      </div>

      <!-- Media rows -->
      <div class="space-y-5">
        {rows.map((row) => {
          if (row.type === 'pair') {
            return (
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                {row.items.map((item) => (
                  <div data-media-item={item.id}>
                    {/* ── BANNER ── */}
                    {item.type === 'banner' && (
                      <div class="group relative rounded-2xl overflow-hidden border border-white/10 bg-surface/5 hover:border-primary/30 transition-all duration-300 hover:scale-[1.01]"
                        style={item.min_height ? `min-height:${item.min_height}` : 'min-height:180px'}>
                        {(item.image_url ?? item.image) && (
                          <img src={item.image_url ?? item.image} alt={item.alt ?? item.title ?? ''}
                            class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                            loading="lazy" />
                        )}
                        {(item.overlay || item.title || item.description || item.cta_label) && (
                          <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-5 space-y-2">
                            {item.title && <p class="text-lg font-bold text-white leading-tight">{item.title}</p>}
                            {item.description && <p class="text-sm text-white/75 line-clamp-2 leading-relaxed">{item.description}</p>}
                            {item.cta_label && (item.resolved_cta_href ?? item.cta_href) && (
                              <a href={item.resolved_cta_href ?? item.cta_href} target={item.cta_target ?? '_self'}
                                rel={item.cta_target === '_blank' ? 'noopener noreferrer' : undefined}
                                class="inline-flex items-center gap-1.5 self-start px-4 py-2 bg-primary hover:bg-primary/90 text-white text-xs font-bold rounded-xl transition-colors">
                                {item.cta_label}
                                <ArrowUpRight class="w-3.5 h-3.5 stroke-[2.5]" />
                              </a>
                            )}
                          </div>
                        )}
                      </div>
                    )}

                    {/* ── FLYER ── */}
                    {item.type === 'flyer' && (
                      <Fragment>
                        {(item.resolved_href ?? item.href) ? (
                          <a href={item.resolved_href ?? item.href} target={item.target ?? '_self'}
                            rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                            class="group block rounded-2xl overflow-hidden border border-white/10 hover:border-primary/40 transition-all duration-300 hover:scale-[1.01]">
                            <img src={item.image_url ?? item.image} alt={item.alt ?? ''}
                              class="w-full object-cover group-hover:scale-105 transition-transform duration-500"
                              loading="lazy" />
                          </a>
                        ) : (
                          <div class="rounded-2xl overflow-hidden border border-white/10">
                            <img src={item.image_url ?? item.image} alt={item.alt ?? ''} class="w-full object-cover" loading="lazy" />
                          </div>
                        )}
                      </Fragment>
                    )}

                    {/* ── VIDEO ── */}
                    {item.type === 'video' && (() => {
                      const src = embedSrc(item.provider, item.video_id);
                      return src ? (
                        <div class="rounded-2xl overflow-hidden border border-white/10 bg-black/30 relative" style="padding-top:56.25%;">
                          <iframe src={src} title={item.title ?? 'Video'}
                            class="absolute inset-0 w-full h-full"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen loading="lazy" frameborder="0" />
                        </div>
                      ) : null;
                    })()}
                  </div>
                ))}
              </div>
            );
          }

          // Single row
          const item = row.item;
          return (
            <div data-media-item={item.id}>
              {/* ── BANNER ── */}
              {item.type === 'banner' && (
                <div class="group relative rounded-2xl overflow-hidden border border-white/10 bg-surface/5 hover:border-primary/30 transition-all duration-300 hover:scale-[1.005]"
                  style={item.min_height ? `min-height:${item.min_height}` : 'min-height:220px'}>
                  {(item.image_url ?? item.image) && (
                    <img src={item.image_url ?? item.image} alt={item.alt ?? item.title ?? ''}
                      class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy" />
                  )}
                  {(item.title || item.description || item.cta_label) && (
                    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent flex flex-col justify-end p-6 space-y-2">
                      {item.title && <p class="text-2xl font-bold text-white leading-tight">{item.title}</p>}
                      {item.description && <p class="text-sm text-white/75 max-w-md leading-relaxed">{item.description}</p>}
                      {item.cta_label && (item.resolved_cta_href ?? item.cta_href) && (
                        <a href={item.resolved_cta_href ?? item.cta_href} target={item.cta_target ?? '_self'}
                          rel={item.cta_target === '_blank' ? 'noopener noreferrer' : undefined}
                          class="inline-flex items-center gap-1.5 self-start px-5 py-2.5 bg-primary hover:bg-primary/90 text-white text-sm font-bold rounded-xl transition-colors mt-1">
                          {item.cta_label}
                          <ArrowUpRight class="w-4 h-4 stroke-[2.5]" />
                        </a>
                      )}
                    </div>
                  )}
                </div>
              )}

              {/* ── FLYER ── */}
              {item.type === 'flyer' && (
                <Fragment>
                  {(item.resolved_href ?? item.href) ? (
                    <a href={item.resolved_href ?? item.href} target={item.target ?? '_self'}
                      rel={item.target === '_blank' ? 'noopener noreferrer' : undefined}
                      class="group block rounded-2xl overflow-hidden border border-white/10 hover:border-primary/40 transition-all duration-300">
                      <img src={item.image_url ?? item.image} alt={item.alt ?? ''}
                        class="w-full object-cover group-hover:scale-[1.02] transition-transform duration-500"
                        loading="lazy" />
                    </a>
                  ) : (
                    <div class="rounded-2xl overflow-hidden border border-white/10">
                      <img src={item.image_url ?? item.image} alt={item.alt ?? ''} class="w-full object-cover" loading="lazy" />
                    </div>
                  )}
                </Fragment>
              )}

              {/* ── VIDEO ── */}
              {item.type === 'video' && (() => {
                const src = embedSrc(item.provider, item.video_id);
                return src ? (
                  <div class="space-y-2">
                    {item.title && <h3 class="text-base font-bold text-white px-0.5">{item.title}</h3>}
                    <div class="rounded-2xl overflow-hidden border border-white/10 bg-black/30 relative" style="padding-top:56.25%;">
                      <iframe src={src} title={item.title ?? 'Video'}
                        class="absolute inset-0 w-full h-full"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen loading="lazy" frameborder="0" />
                    </div>
                    {item.caption && <p class="text-xs text-primary-text/50 px-0.5">{item.caption}</p>}
                  </div>
                ) : null;
              })()}
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
