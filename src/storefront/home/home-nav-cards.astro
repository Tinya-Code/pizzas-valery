---
/**
 * Home — Navigation CTA cards (Menú / Galería / Contacto).
 * Supports declarative configuration from landing.json block, or fallback defaults.
 */
import ArrowRight from '../icons/arrow-right.astro';
import Images from '../icons/images.astro';
import Share2 from '../icons/share-2.astro';
import Utensils from '../icons/utensils.astro';
import Phone from '../icons/phone.astro';
import MapPin from '../icons/map-pin.astro';

const { block } = Astro.props;

const defaultCards = [
  {
    id: 'card-menu',
    icon: 'utensils',
    title: 'Ver menú',
    description: 'Explorá nuestra carta completa de makis, combos especiales y promociones.',
    cta_label: 'Explorar carta',
    href: '/menu',
  },
  {
    id: 'card-galeria',
    icon: 'images',
    title: 'Galería',
    description: 'Descubrí cada plato y la presentación artesanal de nuestras variedades.',
    cta_label: 'Ver fotos',
    href: '/galeria',
  },
  {
    id: 'card-contacto',
    icon: 'share-2',
    title: 'Contacto',
    description: 'Pedidos por WhatsApp, redes sociales, horarios y ubicación en mapa.',
    cta_label: 'Contactar',
    href: '/enlaces',
  },
];

const cards = block?._cards ?? block?.cards ?? defaultCards;
---

<section class="px-6 pb-20 sm:pb-28" id={block?.id ?? "home-nav-cards"}>
  <div class="max-w-5xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-left">
      {cards.map((card) => {
        const href = card.resolved_href ?? card.href ?? '#';
        return (
          <a
            href={href}
            class="group relative bg-surface/5 border border-white/10 hover:border-primary/50 rounded-3xl p-6 sm:p-8 flex flex-col items-center text-center transition-all duration-300 hover:scale-[1.02] hover:shadow-[0_20px_40px_rgba(220,38,38,0.2)]"
          >
            <div class="w-16 h-16 rounded-2xl bg-primary/10 border border-primary/20 text-primary flex items-center justify-center mb-5 group-hover:bg-primary group-hover:text-white transition-colors duration-300">
              {card.icon === 'utensils' && <Utensils class="w-8 h-8" />}
              {card.icon === 'images' && <Images class="w-8 h-8" />}
              {card.icon === 'share-2' && <Share2 class="w-8 h-8" />}
              {card.icon === 'phone' && <Phone class="w-8 h-8" />}
              {card.icon === 'map-pin' && <MapPin class="w-8 h-8" />}
              {!['utensils', 'images', 'share-2', 'phone', 'map-pin'].includes(card.icon) && (
                <Utensils class="w-8 h-8" />
              )}
            </div>
            <h2 class="text-2xl font-display text-white mb-2">{card.title}</h2>
            {card.description && (
              <p class="text-sm text-primary-text/70 leading-relaxed flex-1">{card.description}</p>
            )}
            <div class="mt-6 flex items-center gap-2 text-primary font-bold text-sm tracking-wider uppercase">
              <span>{card.cta_label ?? 'Ver más'}</span>
              <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
