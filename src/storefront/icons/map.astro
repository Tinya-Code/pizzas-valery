---
/**
 * `map` icon — Lucide geometry (24×24). One component per glyph, so consumers
 * import exactly the icon they use instead of a name-based dispatcher.
 *
 * Props:
 * - `class` — sizing / colouring classes applied to the `<svg>`
 * - any extra attribute (`aria-label`, `data-*`, …) is forwarded to the `<svg>`
 */
interface Props {
  class?: string;
  [key: string]: unknown;
}

const { class: className, ...attrs } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  {...attrs}
>
