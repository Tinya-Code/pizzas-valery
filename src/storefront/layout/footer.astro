---
/**
 * Footer — contact, hours, branding, social links and credits.
 *
 * Props:
 * - `restaurant`    — profile (name, phone) loaded by the page
 * - `settings`      — v2 settings payload (social links)
 * - `businessHours` — weekly schedule; today's row renders from it
 * - `class`         — pass-through host classes
 *
 * The page loads every value once and passes it down (F5); this component
 * never fetches.
 *
 * Note: v2 dropped `settings.description` (the SEO block owns the site
 * description now). The branding paragraph below stays EMPTY exactly as the
 * v1 page rendered it — the element must not disappear or the `space-y-6`
 * spacing of that column changes.
 */
import ArrowUpRight from "../icons/arrow-up-right.astro";
import DeveloperSignature from "./developer-signature.astro";
import Facebook from "../icons/facebook.astro";
import Instagram from "../icons/instagram.astro";
import TikTok from "../icons/tiktok.astro";
import Phone from "../icons/phone.astro";
import Star from "../icons/star.astro";
import Utensils from "../icons/utensils.astro";
import { timeFormat } from "../utils/format.js";
import { weekDayKey } from "../services/business-hours.service.js";
import type {
  BusinessHours,
  RestaurantProfile,
  RestaurantSettings,
  SocialMedia,
} from "../types/menu";

interface Props {
  class?: string;
  restaurant?: RestaurantProfile | null;
  settings?: RestaurantSettings | null;
  businessHours?: BusinessHours;
  footerBg?: string | null;
}

const {
  class: hostClass = "",
  restaurant = null,
  settings = null,
  businessHours = {},
  footerBg: explicitFooterBg = null,
} = Astro.props;

const restaurantName = restaurant?.name ?? "TU RESTAURANTE";
const restaurantPhone = restaurant?.phone ?? "";
const socialMedia: Partial<SocialMedia> = settings?.social_media ?? {};
const googleMapsUrl = settings?.google_maps ?? socialMedia.google_maps ?? null;
const logoUrl = settings?.logo_url ?? null;
const footerBg = explicitFooterBg ?? settings?.footer_bg ?? null;

/** Opening schedule for today (`null` when the schedule never arrived). */
const todayHours = businessHours[weekDayKey()] ?? null;
---

<footer
  class={`pt-24 pb-6 bg-secondary border-t-[12px] border-primary rounded-t-[100px] overflow-hidden relative text-white ${hostClass}`}
  style={footerBg
    ? `background-image: url(${footerBg}); background-size: cover; background-position: center;`
    : undefined}
>
  <!-- Background Accents -->

  <div class="max-w-7xl mx-auto px-8 relative z-10">
    <!-- Top Section: 3 Columns -->
    <div
      class="grid grid-cols-1 md:grid-cols-3 gap-16 items-start pb-20 border-b border-white/5"
    >
      <!-- Left: Contact & Hours -->
      <div class="space-y-8 flex flex-col items-center text-center">
        <div class="flex flex-col items-center">
          <span class="text-2xl font-display uppercase text-primary mb-6 block">
            Contacto & Horarios
          </span>
          <a
            href={`tel:${restaurantPhone}`}
            class="group inline-flex items-center gap-4 text-3xl font-display hover:text-primary transition-colors duration-300"
          >
            <Phone class="w-5 h-5 text-accent" />
            {restaurantPhone}
          </a>
        </div>

        {
          todayHours && (
            <div class="flex flex-col items-center">
              <p class="text-md text-white/40">Horario de Hoy</p>
              <p class="text-lg font-bold text-accent">
                {timeFormat(todayHours.open)} — {timeFormat(todayHours.close)}
              </p>
            </div>
          )
        }
      </div>

      <!-- Center: Branding -->
      <div
        class="flex flex-col items-center text-center space-y-6 order-first md:order-none"
      >
        <div class="relative">
          <div class="absolute inset-0 bg-primary blur-2xl opacity-20"></div>
          <div
            class="w-24 h-24 bg-gradient-to-tr from-primary to-primary/80 rounded-[2rem] flex items-center justify-center shadow-2xl transform hover:rotate-12 transition-transform duration-500 overflow-hidden"
          >
            {
              logoUrl ? (
                <img
                  src={logoUrl}
                  alt={restaurantName}
                  class="w-full h-full object-cover"
                />
              ) : (
                <Utensils class="w-12 h-12 text-white" />
              )
            }
          </div>
        </div>
        <h2 class="text-5xl font-display tracking-tighter text-white">
          {restaurantName}
        </h2>
      </div>

      <!-- Right: Social Media -->
      <div class="space-y-8 flex flex-col items-center text-center">
        <div>
          <span class="text-2xl font-display text-primary mb-6 block"
            >Siguenos</span
          >
          <div class="flex items-center justify-center gap-5">
            {
              socialMedia.facebook && (
                <a
                  href={socialMedia.facebook}
                  target="_blank"
                  class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center group hover:bg-primary hover:border-primary transition-all duration-300"
                >
                  <Facebook class="w-6 h-6 text-white/60 group-hover:text-white group-hover:scale-110 transition-all" />
                </a>
              )
            }
            {
              socialMedia.instagram && (
                <a
                  href={socialMedia.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Instagram"
                  class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center group hover:bg-primary hover:border-primary transition-all duration-300"
                >
                  <Instagram class="w-6 h-6 text-white/60 group-hover:text-white group-hover:scale-110 transition-all" />
                </a>
              )
            }
            {
              socialMedia.tiktok && (
                <a
                  href={socialMedia.tiktok}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="TikTok"
                  class="w-14 h-14 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center group hover:bg-primary hover:border-primary transition-all duration-300"
                >
                  <TikTok class="w-6 h-6 text-white/60 group-hover:text-white group-hover:scale-110 transition-all" />
                </a>
              )
            }
          </div>

          {
            googleMapsUrl && (
              <div class="pt-5 flex flex-col items-center md:items-end w-full">
                <a
                  href={googleMapsUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-open-review-modal
                  class="inline-flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 hover:border-amber-500/60 text-white font-bold text-xs uppercase tracking-wider transition-all duration-300 hover:scale-[1.02] shadow-lg group cursor-pointer"
                  title="Déjanos tu reseña en Google Maps"
                >
                  <div class="flex items-center gap-0.5 text-amber-400">
                    <Star class="w-3.5 h-3.5 fill-amber-400 text-amber-400 group-hover:scale-110 transition-transform" />
                    <Star class="w-3.5 h-3.5 fill-amber-400 text-amber-400 group-hover:scale-110 transition-transform" />
                    <Star class="w-3.5 h-3.5 fill-amber-400 text-amber-400 group-hover:scale-110 transition-transform" />
                    <Star class="w-3.5 h-3.5 fill-amber-400 text-amber-400 group-hover:scale-110 transition-transform" />
                    <Star class="w-3.5 h-3.5 fill-amber-400 text-amber-400 group-hover:scale-110 transition-transform" />
                  </div>
                  <span>Dejar reseña</span>
                  <ArrowUpRight class="w-3.5 h-3.5 text-white/70 group-hover:text-white group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
                </a>
              </div>
            )
          }
        </div>
      </div>
    </div>

    <!-- Developer Signature -->
    <DeveloperSignature />
  </div>
</footer>
