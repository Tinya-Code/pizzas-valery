---
/**
 * Header — brand, address and share actions.
 *
 * Props:
 * - `restaurant` — profile rendered here (name, address, coordinates); the
 *                  page loads it once and passes it down (F5)
 * - `class`      — pass-through host classes (the Angular component exposed
 *                  no outputs)
 *
 * Client actions (no Angular outputs to mirror):
 * - `[data-copy-address]` — copies the address to the clipboard
 * - `[data-open-maps]`    — opens Google Maps (coordinates when available,
 *                           the address otherwise)
 *
 * Note: the old `/menu` and `/gallery` anchors are gone — neither route
 * exists (the only page is `/`).
 */
import Copy from "../icons/copy.astro";
import Images from "../icons/images.astro";
import Map from "../icons/map.astro";
import MapPin from "../icons/map-pin.astro";
import Utensils from "../icons/utensils.astro";
import ShareButton from "../ui/share-button.astro";
import type { RestaurantProfile, RestaurantSettings, Theme } from "../types/menu";

interface Props {
  class?: string;
  restaurant?: RestaurantProfile | null;
  settings?: RestaurantSettings | null;
  /** Page presentation: backgrounds + brand assets (single source). */
  theme?: Theme | null;
}

const {
  class: hostClass = "",
  restaurant = null,
  settings = null,
  theme = null,
} = Astro.props;

const restaurantName = restaurant?.name ?? settings?.name ?? "";
const address = restaurant?.address ?? "";
const location = restaurant?.location;
const latitude = location?.lat ?? "";
const longitude = location?.lng ?? "";
const logoUrl = theme?.brand?.logo_url ?? null;
const headerBg = theme?.page?.header_bg ?? null;

const hasCoordinates =
  latitude !== "" &&
  longitude !== "" &&
  latitude !== "undefined" &&
  longitude !== "undefined";
const mapsQuery = hasCoordinates
  ? `${latitude},${longitude}`
  : encodeURIComponent(address);
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${mapsQuery}`;
---

<header
  class={`relative font-body bg-secondary border-b-8 border-primary px-6 pt-12 pb-16 mb-12 rounded-b-[100px] overflow-hidden ${hostClass}`}
  style={headerBg
    ? `background-image: url(${headerBg}); background-size: cover; background-position: center;`
    : undefined}
>
  <div
    class="max-w-7xl mx-auto flex flex-col md:flex-row items-center gap-10 relative z-10"
  >
    <!-- Logo Section -->
    <a href="/" class="relative group cursor-pointer">
      {
        logoUrl ? (
          <div class="w-42 h-42   flex items-center justify-center  transform -rotate-6 group-hover:rotate-0 transition-all duration-700 ease-out overflow-hidden">
            <img
              src={logoUrl}
              alt={restaurantName}
              class="w-full h-full object-cover"
            />
          </div>
        ) : (
          <div class="w-32 h-32 bg-gradient-to-br from-primary to-primary/80 rounded-3xl flex items-center justify-center shadow-[0_20px_50px_rgba(220,38,38,0.3)] transform -rotate-6 group-hover:rotate-0 transition-all duration-700 ease-out overflow-hidden">
            <Utensils class="w-16 h-16 text-white" />
          </div>
        )
      }
    </a>

    <!-- Info Section -->
    <div class="text-center md:text-left flex-1 space-y-4">
      <h1
        class="text-6xl md:text-8xl font-display text-white leading-none tracking-tighter"
      >
        {restaurantName}
      </h1>
      <!--mapa -->
      <a
        href={mapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        title="Ver en Google Maps"
        aria-label="Ver en Google Maps"
        class="w-full flex flex-col items-center  md:items-start"
      >
        <div
          class="w-full md:w-auto flex items-center gap-3 px-4 py-2 rounded-xl bg-primary/10 text-primary-text/80 md:flex-row md:gap-2 md:py-2"
        >
          <div class="flex items-start gap-2 min-w-0 md:items-center">
            <MapPin class="w-4 h-4 mt-0.5 text-primary shrink-0 md:mt-0" />
            <span
              class="text-xs font-bold uppercase tracking-wider leading-relaxed break-words"
              >{address}</span
            >
          </div>

          <button
            data-copy-address
            data-address={address}
            type="button"
            title="Copiar dirección"
            aria-label="Copiar dirección"
            class="flex items-center justify-center w-11 h-11 rounded-lg transition-all hover:text-primary hover:scale-110 active:scale-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
          >
            <Copy class="w-6 h-6" />
          </button>
        </div>
        <p
          data-copy-feedback
          role="status"
          aria-live="polite"
          class="h-4 text-xs font-bold text-accent-muted"
        >
        </p>
      </a>
    </div>

    <!-- Action Section -->
    <div class="flex flex-row md:flex-col items-center md:items-end gap-3">
      <!-- Gallery Link -->
      <a
        href="/galeria"
        class="flex items-center gap-2 px-4 py-2 bg-primary hover:bg-primary/80 text-white rounded-sm transition-all duration-300 font-bold border border-primary/20 group backdrop-blur-sm hover:scale-105 active:scale-95"
        title="Ver galería de fotos"
      >
        <Images
          class="w-4 h-4 text-white group-hover:scale-110 transition-transform"
        />
        <span class="text-lg uppercase tracking-widest font-display select-none"
          >Galería</span
        >
      </a>

      <!-- Share Button (copy comes from `theme.share`) -->
      <ShareButton
        title={theme?.share?.title}
        text={theme?.share?.text}
        label={theme?.share?.label}
        buttonTitle={theme?.share?.button_title}
      />
    </div>
  </div>
</header>

<script>
  document.addEventListener("click", async (event) => {
    const target = event.target instanceof Element ? event.target : null;
    if (!target) return;

    const copyButton = target.closest<HTMLElement>("[data-copy-address]");
    if (copyButton) {
      const address = copyButton.dataset.address ?? "";
      const feedback = document.querySelector<HTMLElement>(
        "[data-copy-feedback]",
      );
      try {
        await navigator.clipboard.writeText(address);
        if (feedback) feedback.textContent = "¡Dirección copiada!";
      } catch (error) {
        console.warn("No se pudo copiar la dirección", error);
        if (feedback) feedback.textContent = "No se pudo copiar la dirección";
      }
      window.setTimeout(() => {
        if (feedback) feedback.textContent = "";
      }, 2500);
    }
  });
</script>
