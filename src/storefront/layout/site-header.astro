---
/**
 * SiteHeader — minimal top navigation for landing, galeria and enlaces.
 *
 * Props:
 * - `restaurant` — profile (name) for logo alt and brand text
 * - `settings`   — settings (logo_url)
 * - `class`      — pass-through host classes
 */
import Utensils from "../icons/utensils.astro";
import type { RestaurantProfile, RestaurantSettings } from "../types/menu";

interface Props {
  class?: string;
  restaurant?: RestaurantProfile | null;
  settings?: RestaurantSettings | null;
}

const {
  class: hostClass = "",
  restaurant = null,
  settings = null,
} = Astro.props;

const restaurantName = restaurant?.name ?? "Sazón Digital";
const logoUrl = settings?.logo_url ?? null;

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isMenuActive = currentPath === "/menu";
const isGaleriaActive = currentPath === "/galeria";
---

<!-- Site Header -->
<header
  class={`w-full text-primary-text z-50  mx-auto fixed flex justify-center items-center py-2 px-6 ${hostClass}`}
>
  <nav
    aria-label="Navegación principal"
    class="mx-auto rounded-full font-display w-full p-1 backdrop-blur-sm max-w-md md:max-w-xl flex flex-wrap border border-gray-400/20 items-center justify-center gap-6 sm:gap-10 uppercase tracking-wider"
  >
    <a
      href="/menu"
      class={`transition-colors py-1 border-b-2 ${
        isMenuActive
          ? "text-primary border-primary"
          : "text-primary-text/80 hover:text-white border-transparent"
      }`}
    >
      Menú
    </a>
    <div class="w-15"></div>

    <a
      href="/galeria"
      class={`transition-colors py-1 border-b-2 ${
        isGaleriaActive
          ? "text-primary border-primary"
          : "text-primary-text/80 hover:text-white border-transparent"
      }`}
    >
      Galería
    </a>
  </nav>
  <a
    href="/"
    class="flex items-center fixed z-50 index-z gap-3 p-1 border border-white rounded-full group"
    aria-label="Inicio"
  >
    <div
      class="w-12 h-12 bg-gradient-to-br from-primary to-primary/80 rounded-full flex items-center justify-center shadow-md overflow-hidden transition-transform duration-300 group-hover:scale-105"
    >
      {
        logoUrl ? (
          <img
            src={logoUrl}
            alt={restaurantName}
            class="w-full h-full object-cover"
          />
        ) : (
          <Utensils class="w-6 h-6 text-white" />
        )
      }
    </div>
  </a>
</header>
