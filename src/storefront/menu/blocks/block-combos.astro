---
/**
 * BlockCombos — slider of combo cards with its own section title.
 *
 * Props:
 * - `combos`      — combos rendered inside the slider (required, defaults to `[]`)
 * - `canOrder`    — forwarded to each card (page-loaded ordering flag)
 * - `title`       — section heading (default `'Combos'`)
 * - `description` — section sub-text (default `'Combos especiales para compartir'`)
 *
 * There is no per-combo design slot anymore; the combo's own `card` key
 * declares its design (see `COMBO_CARD_REGISTRY` / `registry.ts`), with the
 * default design as fallback.
 *
 * Combo cards expose a `data-combo` payload; the page dispatches the bubbling
 * `add-to-cart` CustomEvent for them (see `src/pages/index.astro`).
 */
import TemplateComboCard from '../cards/template-combo-card.astro';
import TemplateSectionTitle from '../template-section-title.astro';
import Slider from '../../ui/slider.astro';
import type { Combo } from '../../types/menu';

interface Props {
  combos?: Combo[];
  canOrder?: boolean;
  title?: string;
  description?: string;
}

const {
  combos = [],
  canOrder = true,
  title = 'Combos',
  description = 'Combos especiales para compartir',
} = Astro.props;
---

{
  combos.length > 0 && (
    <section class="relative py-12 px-8">
      <TemplateSectionTitle title={title} description={description} />

      <Slider showArrows={true}>
        {combos.map((combo) => (
          <TemplateComboCard combo={combo} canOrder={canOrder} />
        ))}
      </Slider>
    </section>
  )
}
