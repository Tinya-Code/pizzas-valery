---
/**
 * DecorationRenderer — renders a collection of generic decoration items.
 *
 * Used inside MenuBlock decoration slots (left, right, extra) or standalone.
 * Configured via `src/data/api/decorations.json`.
 */
import type { DecorationItem } from '../../types/menu';

interface Props {
  items?: DecorationItem[];
}

const { items = [] } = Astro.props;
---

{
  items.map((item) => {
    if (item.type === 'rail') {
      return (
        <div
          class={item.containerClass ?? 'relative hidden md:block col-span-0 md:col-span-2 h-full'}
          data-maki-container
          data-rail-urls={JSON.stringify(item.items ?? [])}
          {...item.attrs}
        />
      );
    }

    if (item.type === 'image') {
      return (
        <div class={item.containerClass ?? 'relative md:block col-span-1 md:col-span-2 h-full'}>
          <img
            src={item.src}
            alt={item.alt ?? ''}
            class={item.class ?? 'w-full h-auto'}
            data-anim={item.animation}
            {...item.attrs}
          />
        </div>
      );
    }

    if (item.type === 'group') {
      return (
        <div class={item.containerClass ?? 'flex col-span-12'}>
          {item.images.map((img) => (
            <img
              src={img.src}
              alt={img.alt ?? ''}
              class={img.class ?? 'h-full md:h-auto'}
              data-anim={img.animation}
            />
          ))}
        </div>
      );
    }

    return null;
  })
}
