---
/**
 * MenuBlock — generic skeleton for one menu section.
 *
 * Zero block-specific knowledge: grid classes, section attributes and
 * decoration markup all arrive from the caller (props + ONE NAMED SLOT). The
 * component owns only the shared skeleton (category sections + cards) and
 * the client-side animation bootstrap.
 *
 * Props:
 * - `categories`      — categories rendered as sections; when empty the
 *                       block renders NOTHING (rendering guard).
 * - `decorations`     — decoration items for THIS block (from
 *                       `decorations.json` via `decorations.blocks[block-N]`);
 *                       they are filtered by `slot` (left / right / extra) and
 *                       rendered by DecorationRenderer. This is the ONLY way
 *                       decorations enter a block — pass the prop on every
 *                       block declaration so new data in decorations.json
 *                       renders without touching this file.
 * - `sectionAttrs`    — extra section attributes (e.g. `data-block-1`,
 *                       `data-maki-urls` for the client-side maki rail).
 * - `outerClass` / `cardsClass` / `categorySectionClass` — per-block grids
 * - `canOrder`         — card flag the page resolves once (F5)
 *
 * Card designs are DECLARATIVE: every category carries its own `card` map
 * (state → design key, see menu.json) and TemplateCard resolves it through
 * `registry.ts`. There is NO `card` slot / function child anymore.
 *
 * Named slots:
 * - `extra`   — extra grid cell(s) after the decorations (block-7 illustration)
 * - default   — content at the end of the section
 */
import TemplateCard from '../cards/template-card.astro';
import TemplateSectionTitle from '../template-section-title.astro';
import DecorationRenderer from './decoration-renderer.astro';
import type { MenuCategory, DecorationItem, RailDecorationItem } from '../../types/menu';

interface Props {
  categories?: MenuCategory[];
  decorations?: DecorationItem[];
  sectionAttrs?: Record<string, string>;
  outerClass?: string;
  cardsClass?: string;
  categorySectionClass?: string;
  canOrder?: boolean;
}

const {
  categories = [],
  decorations = [],
  sectionAttrs = {},
  outerClass = '',
  cardsClass = '',
  categorySectionClass = '',
  canOrder = true,
} = Astro.props;

const leftDecorations = decorations.filter((d) => d.slot === 'left');
const rightDecorations = decorations.filter((d) => d.slot === 'right');
const extraDecorations = decorations.filter((d) => d.slot === 'extra');

const railItem = decorations.find((d) => d.type === 'rail') as RailDecorationItem | undefined;
const resolvedSectionAttrs = {
  ...sectionAttrs,
  ...(railItem && !sectionAttrs['data-maki-urls']
    ? { 'data-maki-urls': JSON.stringify(railItem.items ?? []) }
    : {}),
};

const hasLeft = leftDecorations.length > 0;
const hasRight = rightDecorations.length > 0;
const hasDecorations = hasLeft || hasRight;
const hasCustomSlot = Astro.slots.has('default');
---

{
  (categories.length > 0 || hasCustomSlot) && (
    <section
      {...resolvedSectionAttrs}
      class={`relative py-12 px-8${hasDecorations ? ' overflow-hidden' : ''}`}
    >
      <div class={`grid ${outerClass}`}>
        {hasLeft && <DecorationRenderer items={leftDecorations} />}

        {categories.map((cat) => (
          <section
            id={`category-${cat.id}`}
            class={`flex flex-col scroll-mt-[140px] ${categorySectionClass}`.trim()}
          >
            <TemplateSectionTitle title={cat.name ?? ''} description={cat.description || ''} />

            <div class={`grid ${cardsClass}`}>
              {(cat.products ?? []).map((product) => (
                <TemplateCard
                  product={product}
                  canOrder={canOrder}
                  card={cat.card}
                />
              ))}
            </div>
          </section>
        ))}

        {hasRight && <DecorationRenderer items={rightDecorations} />}

        {Astro.slots.has('extra') ? (
          <slot name="extra" />
        ) : (
          extraDecorations.length > 0 && <DecorationRenderer items={extraDecorations} />
        )}
      </div>

      <slot />
    </section>
  )
}

<script>
  import { initAnimations } from '../../scripts/animations';

  const initAll = () => initAnimations(document);

  // Wait for full paint so images have real offsetHeight before calculating.
  if (document.readyState === 'complete') {
    initAll();
  } else {
    window.addEventListener('load', initAll, { once: true });
  }
  // Covers Astro's client-side navigation as well as the initial render.
  document.addEventListener('astro:page-load', initAll);
</script>
