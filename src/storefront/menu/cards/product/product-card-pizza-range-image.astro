---
/**
 * ProductCardPizzaRange — price-range product design for block-1
 * (`range-with-image` state only; flat/no-image products fall back to
 * ProductRow via TemplateCard's router).
 *
 * Props:
 * - `product`  — v2 product payload (required; range embedded)
 * - `canOrder` — whether the storefront accepts orders right now
 *
 * Owns its root + the CLIENT CONTRACT `data-template-card`, `data-has-range`,
 * `data-product` — the page's click delegation reads it from the root.
 */
import Plus from "../../../icons/plus.astro";
import Star from "../../../icons/star.astro";
import { precio } from "../../../utils/format.js";
import type { MenuProduct } from "../../../types/menu";

interface Props {
  product: MenuProduct;
  canOrder?: boolean;
}

const { product, canOrder = true } = Astro.props;

/** Minimum price (the API computes it). */
---

<!-- DISEÑO: card de rango de precio para block-1 (pizzas) -->
<div
  data-template-card
  data-has-range="true"
  data-product={JSON.stringify(product ?? {})}
  class="group relative bg-primary rounded-t-xl rounded-b-[120px]  p-4  items-center transition-all duration-300 cursor-pointer text-white flex flex-col h-full"
>
  <!-- Image (top circle) -->

  <!-- Title & Badge -->
  <div class="relative flex flex-col w-full ">
    <h3
      class="text-4xl flex items-start justify-between gap-2 font-display text-white tracking-tight transition-colors"
    >
      {product.name}
      {
        product.is_recommended && (
          <Star class="w-5 h-5 text-accent fill-accent" />
        )
      }
    </h3>
  </div>

  <!-- Bottom: Info & Selection Action -->
  <div class="mt-auto w-full relative flex flex-col justify-between">
    {
      product.price_range?.entries.map((element) => (
        <div class="flex gap-2">
          <span class="text-xl font-display text-white tracking-tighter">
            {element.label} :
          </span>
          <span class="text-3xl font-display text-accent tracking-tighter">
            {precio(element.price)}
          </span>
        </div>
      ))
    }

    {
      canOrder && (
        <div class="flex  justify-between w-full mb-2 items-center gap-2 px-4 py-2 border-2 border-accent group-hover:bg-accent transition-colors">
          <span class="text-xs font-body font-bold uppercase tracking-widest">
            Elegir
          </span>
          <Plus class="w-4 h-4 font-bold" />
        </div>
      )
    }
  </div>
  <div class=" flex rounded-full ring-8 ring-primary h-40 w-40 bg-secondary justify-center">
    {
      product.image.url && (
        <img
          src={product.image.url}
          class="w-full h-auto object-contain drop-shadow-2xl transform group-hover:scale-110 group-hover:-rotate-6 transition-transform duration-700"
          alt={product.image.alt}
        />
      )
    }
  </div>
</div>
