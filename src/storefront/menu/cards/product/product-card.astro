---
/**
 * ProductCard — price-range product design (prominent card, "Elegir cantidades").
 * State coverage: `range-with-image` and `range-no-image` (the media circle
 * renders empty when the product has no image).
 *
 * Props:
 * - `product`  — v2 product payload (required; range embedded)
 * - `canOrder` — whether the storefront accepts orders right now
 *
 * Owns its root + the CLIENT CONTRACT `data-template-card`, `data-has-range`,
 * `data-product` — the page's click delegation reads it from the root.
 */
import Plus from '../../../icons/plus.astro';
import Star from '../../../icons/star.astro';
import AddButton from '../../../commerce/add-button.astro';
import { precio } from '../../../utils/format.js';
import type { MenuProduct } from '../../../types/menu';

interface Props {
  product: MenuProduct;
  canOrder?: boolean;
}

const { product, canOrder = true } = Astro.props;

/** Minimum price (the API computes it). */
const startingPrice = product.price;
---

<!-- DISEÑO: Producto con Rangos de Precio (Estilo Card Prominente) -->
<div
  data-template-card
  data-has-range="true"
  data-product={JSON.stringify(product ?? {})}
  class="group relative p-4 justify-between items-center transition-all duration-300 overflow-hidden cursor-pointer bg-primary text-white rounded-b-xl rounded-t-[120px] flex flex-col h-full"
>
  <!-- Image (Side position) -->
  <div class="relative flex rounded-full h-40 w-40 bg-secondary justify-center">
    {product.image.url && (
      <img
        src={product.image.url}
        class="w-full h-auto object-contain drop-shadow-2xl transform group-hover:-translate-x-4 transition-transform duration-700"
        alt={product.image.alt}
      />
    )}
  </div>

  <!-- Title & Badge -->
  <div class="relative flex flex-col w-full pt-4">
    <h3 class="text-4xl flex items-start justify-between gap-2 font-display text-white tracking-tight transition-colors">
      {product.name}
      {product.is_recommended && <Star class="w-5 h-5 text-accent fill-accent" />}
    </h3>
  </div>

  <!-- Bottom: Info & Selection Action -->
  <div class="mt-auto w-full relative flex flex-col justify-between">
    <div class="flex flex-col">
      <span class="text-xs font-body font-bold uppercase tracking-[0.2em] text-white/70">Desde</span>
      <span class="text-3xl font-display text-accent tracking-tighter">{precio(startingPrice)}</span>
    </div>

    {canOrder && (
      <div class="flex justify-between w-full items-center gap-2 px-4 py-2 border-2 border-accent group-hover:bg-accent transition-colors">
        <span class="text-xs font-body font-bold uppercase tracking-widest">Elegir cantidades</span>
        <Plus class="w-4 h-4 font-bold" />
      </div>
    )}
  </div>
</div>
