---
/**
 * TemplateCard — product design router (markup + client contract).
 *
 * Resolves the product's STATE (price range × image) to one of four named
 * design slots and renders the caller's function-child when present, or the
 * built-in default design for that state:
 *
 *   flat-with-image  → ProductRow (thumbnail branch)
 *   flat-no-image    → ProductRow (no-thumb branch)
 *   range-with-image → ProductCard
 *   range-no-image   → ProductCard (empty media circle)
 *
 * Every design owns its root element and the CLIENT CONTRACT
 * `data-template-card`, `data-has-range`, `data-product` — the page's click
 * delegation reads it. A custom design MUST carry all three.
 *
 * Override per block (function children — Astro 7's scoped-slot mechanism):
 *
 *   <TemplateCard product={product} canOrder={canOrder}>
 *     <fragment slot="range-with-image">
 *       {(product, canOrder) => <MyPizzaCard product={product} canOrder={canOrder} />}
 *     </fragment>
 *   </TemplateCard>
 *
 * Swap a default globally: change the import + fallback below (one line).
 */
import ProductRow from './product/product-row.astro';
import ProductCard from './product/product-card.astro';
import type { MenuProduct } from '../../types/menu';

interface Props {
  product: MenuProduct;
  canOrder?: boolean;
}

const { product, canOrder = true } = Astro.props;

const hasPriceRange = !!product.price_range;
const hasImage = !!product.image?.url;

const designSlot = hasPriceRange
  ? hasImage
    ? 'range-with-image'
    : 'range-no-image'
  : hasImage
    ? 'flat-with-image'
    : 'flat-no-image';

// Function-children slot content is rendered to HTML per card (Astro 7
// replaced `let:` scoped slots with Astro.slots.render + function children).
const customHtml = Astro.slots.has(designSlot)
  ? await Astro.slots.render(designSlot, [product, canOrder])
  : null;
---

{
  customHtml !== null ? (
    <Fragment set:html={customHtml} />
  ) : hasPriceRange ? (
    <ProductCard product={product} canOrder={canOrder} />
  ) : (
    <ProductRow product={product} canOrder={canOrder} />
  )
}
