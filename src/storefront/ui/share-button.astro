---
/**
 * ShareButton — native share with a clipboard fallback.
 *
 * Props: the share-sheet copy comes from `theme.share` (data), never from
 * code: `title` / `text` feed `navigator.share`, `label` is the visible
 * button text and `buttonTitle` its tooltip. Angular `output()` surface:
 * none.
 *
 * Client only: `navigator.share` when available, otherwise the URL is copied
 * to the clipboard. The copy reaches the client through `data-share-*`
 * attributes (the bundled script cannot read frontmatter values).
 */
import Share2 from '../icons/share-2.astro';

interface Props {
  class?: string;
  /** `navigator.share` title. */
  title?: string;
  /** `navigator.share` body text. */
  text?: string;
  /** Visible button label. */
  label?: string;
  /** Button tooltip (`title` attribute). */
  buttonTitle?: string;
}

const {
  class: hostClass = '',
  title = '',
  text = '',
  label = 'Compartir',
  buttonTitle = 'Compartir este menú',
} = Astro.props;
---

<button
  data-share-button
  data-share-title={title || null}
  data-share-text={text || null}
  type="button"
  class={`flex items-center gap-2 px-4 py-2 bg-primary/80 hover:bg-primary text-white rounded-sm transition-all duration-300 font-bold border border-primary/20 group backdrop-blur-sm ${hostClass}`}
  title={buttonTitle}
>
  <Share2 class="w-4 h-4 group-hover:scale-110 transition-transform" />
  <span class="text-lg uppercase tracking-widest font-display select-none">{label}</span>
</button>

<script>
  document.addEventListener('click', async (event) => {
    const target = event.target instanceof Element ? event.target : null;
    const button = target?.closest('[data-share-button]');
    if (!button) return;

    const url = window.location.href;
    const shareData: ShareData = { url };
    const shareTitle = button.getAttribute('data-share-title');
    const shareText = button.getAttribute('data-share-text');
    if (shareTitle) shareData.title = shareTitle;
    if (shareText) shareData.text = shareText;

    if (navigator.share) {
      try {
        await navigator.share(shareData);
      } catch (error) {
        if (error instanceof DOMException && error.name !== 'AbortError') {
          console.error('Error al compartir:', error);
        }
      }
      return;
    }

    try {
      await navigator.clipboard.writeText(url);
      alert('Enlace copiado al portapapeles');
    } catch {
      console.warn('La API Web Share no está soportada y no se pudo copiar al portapapeles');
    }
  });
</script>
