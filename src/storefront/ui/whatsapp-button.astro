---
/**
 * WhatsAppButton — floating WhatsApp bubble with a pure CSS auto-hiding tooltip.
 *
 * Props:
 * - `phone`   — number the link opens
 * - `message` — prefilled message
 *
 * The URL is built in frontmatter. Tooltip visibility is 100% CSS:
 * - `@keyframes` reveals it after ~3 s and hides it after ~8 s.
 * - `group-hover` overrides and displays it on cursor hover.
 * Zero client JavaScript.
 */
import { WhatsApp } from '../utils/whatsapp.js';
import Whatsapp from '../icons/whatsapp.astro';

interface Props {
  phone?: string;
  message?: string | null;
}

const { phone = '', message = null } = Astro.props;

const whatsappUrl = WhatsApp.link(phone, message ?? 'Hola, me gustaría información');
---

<div
  class="group fixed bottom-24 right-6 z-10 flex flex-col items-end gap-2 pb-[env(safe-area-inset-bottom)]"
>
  <div
    class="whatsapp-tooltip bg-slate-900 text-white px-3 py-1.5 rounded-lg shadow-lg text-[10px] font-medium tracking-wide uppercase transition-all duration-300 origin-right opacity-0 translate-x-4 pointer-events-none group-hover:!opacity-100 group-hover:!translate-x-0 group-hover:!pointer-events-auto"
  >
    Escríbenos
  </div>

  <a
    href={whatsappUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="w-12 h-12 bg-[#25D366] text-white rounded-full shadow-md hover:shadow-lg flex items-center justify-center transition-all duration-200 relative"
    aria-label="Hablar por WhatsApp"
  >
    <Whatsapp class="w-6 h-6 fill-current" />
  </a>
</div>

<style>
  @keyframes tooltipAutoFade {
    0%, 25% {
      opacity: 0;
      transform: translateX(1rem);
      pointer-events: none;
    }
    30%, 90% {
      opacity: 1;
      transform: translateX(0);
      pointer-events: auto;
    }
    100% {
      opacity: 0;
      transform: translateX(1rem);
      pointer-events: none;
    }
  }

  .whatsapp-tooltip {
    animation: tooltipAutoFade 11s ease forwards;
  }
</style>
